{
  "name": "videoshare",
  "version": "1.0.0",
  "description": "Serverless, open-source Loom replacement: record your screen, encrypt in the browser, upload straight to any S3-compatible bucket.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "jose": "^6.2.10",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
