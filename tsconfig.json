{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "vitest/globals"],

    "strict": true,
    "isolatedModules": true,
    // tests/gateway.test.ts pulls gateway/src into this program, and those files
    // import each other with a real ".ts" extension so Node can run them without
    // a build step (see gateway/tsconfig.json). Type-checking only, never emits.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src", "tests", "vite.config.ts", "vitest.e2e.config.ts"]
}
